---
import Icon from "../components/Icon.astro";
interface Props {
  title: string;
  description?: string;
  home?: boolean;
}
const {
  title,
  description = "Data analytics and information systems portfolio of William Eka Saputra, a student at Universitas Multimedia Nusantara.",
  home = false,
} = Astro.props;
const base = home ? "" : "index.html";
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f8f8f1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · William Eka Saputra</title>
    <link rel="icon" href="assets/mark.svg" />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header>
      <div class="wrap nav">
        <a class="brand" href={home ? "#top" : "index.html"}>
          William Eka Saputra
        </a>
        <nav id="nav">
          <a href={base + "#projects"}>Projects</a>
          <a href={base + "#experience"}>Experience</a>
          <a href={base + "#about"}>About</a>
          <a href={base + "#skills"}>Skills</a>
          <a class="nav-contact" href={base + "#contact"}>
            Contact me
            <Icon name="up" />
          </a>
        </nav>
        <button class="menu" aria-controls="nav" aria-expanded="false" aria-label="Open navigation">
          <Icon name="menu" />
        </button>
      </div>
    </header>
    <slot />
    <footer>
      <div class="wrap foot">
        <span>© 2026 William Eka Saputra</span>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".menu")!;
      const nav = document.querySelector<HTMLElement>("#nav")!;

      function setMenu(open: boolean) {
        nav.classList.toggle("open", open);
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      }
      button.addEventListener("click", () => setMenu(!nav.classList.contains("open")));
      nav.addEventListener("click", () => setMenu(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && nav.classList.contains("open")) {
          setMenu(false);
          button.focus();
        }
      });
    </script>
  </body>
</html>
